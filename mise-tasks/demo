#!/usr/bin/env bash
#MISE description="Run Maven with the extension on a copy of the sample project, e.g. `mise run demo -- surefire:test`"
#MISE depends=["build"]
#USAGE arg "[goals]..." help="Maven goals and flags (default: verify)" var=#true
#USAGE flag "--maven4" help="Use Maven 4 instead of 3.9"
#USAGE flag "--fresh" help="Start from a fresh copy of the sample (keeps the cache)"
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
sample="$root/frontseat-it/src/it/projects/basic-multimodule"
work="$root/target/demo/basic-multimodule"
version="$(cd "$root" && mvn -q help:evaluate -Dexpression=project.version -DforceStdout 2>/dev/null)"
ext="$root/frontseat-maven-extension/target/frontseat-maven-extension-$version.jar"
ext="$ext:$root/frontseat-plugin-io/target/frontseat-plugin-io-$version.jar"
ext="$ext:$root/frontseat-cache-core/target/frontseat-cache-core-$version.jar"

if [[ "${usage_fresh:-false}" == "true" || ! -d "$work" ]]; then
  rm -rf "$work" && mkdir -p "$(dirname "$work")" && cp -r "$sample" "$work"
fi

mvn_bin=mvn
if [[ "${usage_maven4:-false}" == "true" ]]; then
  mvn_bin="$(mise where "maven@${FRONTSEAT_MAVEN4}")/apache-maven-${FRONTSEAT_MAVEN4}/bin/mvn"
fi

# usage_goals is space-separated; default to verify.
read -r -a goals <<< "${usage_goals:-verify}"
cd "$work"
echo "[demo] $mvn_bin ${goals[*]}  (in $work)"
"$mvn_bin" "-Dmaven.ext.class.path=$ext" "${goals[@]}" | grep -E '\[frontseat\]|Tests run:|BUILD|ERROR' || true
