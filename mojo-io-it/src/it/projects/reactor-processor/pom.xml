<?xml version="1.0" encoding="UTF-8"?>
<!--
  app compiles with an annotation processor built by this reactor (processor), named only in
  annotationProcessorPaths, with a release version. The processor's version says nothing about its
  content: a change to it must reach app's compile task.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.example.samples</groupId>
  <artifactId>reactor-processor</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <modules>
    <module>processor</module>
    <module>app</module>
  </modules>
</project>
