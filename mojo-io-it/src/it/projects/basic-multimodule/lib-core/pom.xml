    <artifactId>basic-multimodule</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>lib-core</artifactId>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <id>test-jar</id>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
