<?xml version="1.0" encoding="UTF-8"?>
<!--
  Source roots added while the build runs, as seen by a build system that runs one task at a time from
  the dry-run task graph (mojo-io's mojoio.only.inputCheck):
  - generated-root: a mojo generates sources under target/ and adds them as a source root. Fine: the
    build directory holds outputs of tasks the graph orders.
  - other-root: build-helper's add-source adds src/other, outside target/. The graph, exported before any
    mojo runs, lists only src/main/java for the compiler, so a build system would not hash src/other.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.example.samples</groupId>
  <artifactId>source-roots</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <modules>
    <module>generated-root</module>
    <module>other-root</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
  </properties>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.3.1</version>
        </plugin>
        <plugin>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
        </plugin>
        <plugin>
          <artifactId>maven-antrun-plugin</artifactId>
          <version>3.2.0</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>build-helper-maven-plugin</artifactId>
          <version>3.6.1</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
