<?xml version="1.0" encoding="UTF-8"?>
<!--
  plugin-io 1.0: what a Maven mojo reads and writes, declared in terms of its parameters.

  Every attribute named "parameter" refers to a mojo parameter. Its value is evaluated the way Maven
  configures the mojo (configured expression, else default-value), so the declarations hold for any
  configuration of the plugin.

  Readers MUST treat an unknown input/output kind as "cannot cache this mojo".
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="urn:mojo-io:plugin-io:1.0"
           targetNamespace="urn:mojo-io:plugin-io:1.0"
           elementFormDefault="qualified">

  <xs:element name="plugin-io">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="plugin" type="Plugin" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:complexType name="Plugin">
    <xs:sequence>
      <!-- For a plugin that is a build extension: Ant patterns, relative to a project's directory, of the
           files it reads while Maven loads the project, before any mojo runs (Eclipse Tycho reads
           MANIFEST.MF, feature.xml, target definitions...). Applies to projects whose build has the
           plugin. A build system that runs a task in a sandbox provides these files of the task's
           project and of every reactor project the task loads. -->
      <xs:element name="projectLoad" type="xs:string" minOccurs="0"/>
      <xs:element name="mojo" type="Mojo" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <!-- Optional inside the plugin's own jar (META-INF/maven/plugin-io.xml), required elsewhere. -->
    <xs:attribute name="groupId" type="xs:string"/>
    <xs:attribute name="artifactId" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="Mojo">
    <xs:sequence>
      <xs:element name="inputs" type="Inputs" minOccurs="0"/>
      <xs:element name="outputs" type="Outputs" minOccurs="0"/>
      <!-- Comma or whitespace separated parameters that cannot affect outputs. -->
      <xs:element name="ignoredParameters" type="xs:string" minOccurs="0"/>
      <!-- Comma or whitespace separated Ant patterns, relative to the project build directory, for
           files the mojo writes that are bookkeeping, not outputs (e.g. maven-status/**). Strict mode
           reports any other write outside the declared outputs. -->
      <xs:element name="ignoredWrites" type="xs:string" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="goal" type="xs:string" use="required"/>
    <xs:attribute name="cacheable" type="xs:boolean" default="true"/>
    <!-- Required when cacheable="false". -->
    <xs:attribute name="reason" type="xs:string"/>
    <!-- Phase that must have run before this goal when it is invoked directly. -->
    <!-- How the mojo treats stamp values (project version, build numbers):
         exact (default): it may act on them, so they stay in the cache key;
         carry: it only copies them into outputs (compilers, resource filtering, archivers), so they
                are excluded from the key and rewritten in restored outputs. -->
    <xs:attribute name="stamping" default="exact">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="exact"/>
          <xs:enumeration value="carry"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="Inputs">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <!-- Content of the files / directory trees a parameter names (a path or a list of paths), or that
           a Maven expression evaluates to (e.g. ${project.file}). -->
      <xs:element name="files">
        <xs:complexType>
          <xs:attribute name="parameter" type="xs:string"/>
          <xs:attribute name="expression" type="xs:string"/>
          <!-- Ant patterns, relative to each path, of files not hashed (what the mojo writes there itself). -->
          <xs:attribute name="excludes" type="xs:string"/>
        </xs:complexType>
      </xs:element>
      <!-- An ordered classpath; elements hashed by content, not location. -->
      <xs:element name="classpath">
        <xs:complexType>
          <xs:attribute name="parameter" type="xs:string" use="required"/>
          <!-- Skip this entry (typically the mojo's own output directory). -->
          <xs:attribute name="excludeParameter" type="xs:string"/>
        </xs:complexType>
      </xs:element>
      <!-- The project's resolved test classpath, for mojos that compute it internally. -->
      <xs:element name="testClasspath">
        <xs:complexType>
          <!-- false: without the project's own classes and test-classes directories (dependencies only). -->
          <xs:attribute name="ownOutputs" type="xs:boolean"/>
        </xs:complexType>
      </xs:element>
      <!-- A List<Resource> parameter: resource settings plus selected file content; filtering adds
           project coordinates, project properties and user properties. -->
      <xs:element name="resources">
        <xs:complexType>
          <xs:attribute name="parameter" type="xs:string"/>
          <xs:attribute name="expression" type="xs:string"/>
        </xs:complexType>
      </xs:element>
      <!-- Current value of a project property the mojo reads and rewrites. -->
      <xs:element name="projectFiles">
        <xs:annotation><xs:documentation>The project's own files: its directory without the build directory, nested modules and VCS data.</xs:documentation></xs:annotation>
        <xs:complexType>
          <xs:attribute name="excludes" type="xs:string"/>
        </xs:complexType>
      </xs:element>
      <xs:element name="projectModel">
        <xs:annotation><xs:documentation>The project's effective model, for mojos that read the project rather than their configuration.</xs:documentation></xs:annotation>
        <xs:complexType/>
      </xs:element>
      <xs:element name="reactorModels">
        <xs:annotation><xs:documentation>The effective models of every project of the build. Declaring it is what allows an aggregator mojo to be cached.</xs:documentation></xs:annotation>
        <xs:complexType/>
      </xs:element>
      <xs:element name="sessionGoals">
        <xs:annotation><xs:documentation>The goals and phases the build was started with, for mojos whose result depends on them.</xs:documentation></xs:annotation>
        <xs:complexType/>
      </xs:element>
      <xs:element name="mavenVersion">
        <xs:annotation><xs:documentation>The Maven version, for mojos whose result depends on it.</xs:documentation></xs:annotation>
        <xs:complexType/>
      </xs:element>
      <xs:element name="projectProperty">
        <xs:complexType>
          <xs:attribute name="nameParameter" type="xs:string"/>
          <xs:attribute name="defaultName" type="xs:string" use="required"/>
        </xs:complexType>
      </xs:element>
    </xs:choice>
  </xs:complexType>

  <xs:complexType name="Outputs">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <!-- Files under a directory parameter matching Ant-style includes (default: everything). -->
      <xs:element name="directory">
        <xs:complexType>
          <!-- Exactly one of parameter and expression (e.g. "${project.build.outputDirectory}"). -->
          <xs:attribute name="parameter" type="xs:string"/>
          <xs:attribute name="expression" type="xs:string"/>
          <xs:attribute name="includes" type="xs:string" default="**"/>
        </xs:complexType>
      </xs:element>
      <!-- One file in a directory parameter. name is a template: {param} is the parameter's value,
           {-param} is "-" + value when the value is not empty (e.g. "{finalName}{-classifier}.jar"). -->
      <xs:element name="file">
        <xs:complexType>
          <xs:attribute name="parameter" type="xs:string" use="required"/>
          <xs:attribute name="name" type="xs:string" use="required"/>
        </xs:complexType>
      </xs:element>
      <!-- The files a resources mojo copies into an output directory. -->
      <xs:element name="copiedResources">
        <xs:complexType>
          <xs:attribute name="resourcesParameter" type="xs:string" use="required"/>
          <xs:attribute name="outputDirectoryParameter" type="xs:string" use="required"/>
        </xs:complexType>
      </xs:element>
      <!-- Whatever the mojo writes in the build directory while it runs, measured at run time: for
           mojos that run arbitrary code with hooks of its own (tests, agents such as JaCoCo, forked
           tools). includes/excludes are Ant patterns relative to the build directory. -->
      <xs:element name="observed">
        <xs:complexType>
          <xs:attribute name="includes" type="xs:string" default="**"/>
          <xs:attribute name="excludes" type="xs:string"/>
        </xs:complexType>
      </xs:element>
      <!-- destfile= targets of -javaagent options in a command-line parameter (coverage data). -->
      <xs:element name="javaagentDestFiles" type="ParameterRef"/>
    </xs:choice>
  </xs:complexType>

  <xs:complexType name="ParameterRef">
    <xs:attribute name="parameter" type="xs:string" use="required"/>
  </xs:complexType>
</xs:schema>
