<?xml version="1.0" encoding="UTF-8"?>
<!--
  Built-in plugin I/O declarations: the lowest-precedence source. A plugin's own
  META-INF/maven/plugin-io.xml overrides these, and a project's .mvn/plugin-io/*.xml overrides both.
  These are written so they could move into the plugins themselves unchanged.
-->
<plugin-io xmlns="urn:mojo-io:plugin-io:1.0">

  <plugin groupId="org.apache.maven.plugins" artifactId="maven-resources-plugin">
    <mojo goal="resources">
      <inputs>
        <resources parameter="resources"/>
        <files parameter="filters"/>
        <files parameter="buildFilters"/>
      </inputs>
      <outputs>
        <copiedResources resourcesParameter="resources" outputDirectoryParameter="outputDirectory"/>
      </outputs>
      <ignoredParameters>resources</ignoredParameters>
    </mojo>
    <mojo goal="copy-resources">
      <inputs>
        <resources parameter="resources"/>
        <files parameter="filters"/>
        <files parameter="buildFilters"/>
      </inputs>
      <outputs>
        <copiedResources resourcesParameter="resources" outputDirectoryParameter="outputDirectory"/>
      </outputs>
      <ignoredParameters>resources</ignoredParameters>
    </mojo>
    <mojo goal="testResources">
      <inputs>
        <resources parameter="resources"/>
        <files parameter="filters"/>
        <files parameter="buildFilters"/>
      </inputs>
      <outputs>
        <copiedResources resourcesParameter="resources" outputDirectoryParameter="outputDirectory"/>
      </outputs>
      <ignoredParameters>resources</ignoredParameters>
    </mojo>
  </plugin>

  <plugin groupId="org.codehaus.mojo" artifactId="build-helper-maven-plugin">
    <!-- Only compute project properties from their configuration; the properties are recorded as state. -->
    <mojo goal="parse-version"/>
    <mojo goal="regex-property"/>
    <mojo goal="regex-properties"/>
  </plugin>

  <plugin groupId="org.apache.maven.plugins" artifactId="maven-compiler-plugin">
    <mojo goal="compile">
      <inputs>
        <files parameter="compileSourceRoots"/>
        <classpath parameter="compilePath"/>
        <!-- javac finds annotation processors through the classpath, its own output included: the
             service files resources copied there. -->
        <files expression="${project.build.outputDirectory}/META-INF/services"/>
      </inputs>
      <outputs>
        <directory parameter="outputDirectory" includes="**/*.class"/>
        <directory parameter="generatedSourcesDirectory"/>
      </outputs>
      <ignoredParameters>
        compileSourceRoots, compilePath,
        showCompilationChanges, skipMultiThreadWarning, compilerReuseStrategy, verbose, staleMillis
      </ignoredParameters>
      <!-- Incremental-compilation bookkeeping, not outputs. -->
      <ignoredWrites>maven-status/**</ignoredWrites>
    </mojo>
    <mojo goal="testCompile">
      <inputs>
        <files parameter="compileSourceRoots"/>
        <classpath parameter="testPath"/>
      </inputs>
      <outputs>
        <directory parameter="outputDirectory" includes="**/*.class"/>
        <directory parameter="generatedTestSourcesDirectory"/>
      </outputs>
      <ignoredParameters>
        compileSourceRoots, testPath,
        showCompilationChanges, skipMultiThreadWarning, compilerReuseStrategy, verbose, staleMillis
      </ignoredParameters>
      <!-- Incremental-compilation bookkeeping, not outputs. -->
      <ignoredWrites>maven-status/**</ignoredWrites>
    </mojo>
  </plugin>

  <plugin groupId="org.apache.maven.plugins" artifactId="maven-jar-plugin">
    <!-- Packages classes plus metadata that embeds the version (pom.properties, the pom, MANIFEST.MF). -->
    <mojo goal="jar">
      <inputs>
        <files parameter="classesDirectory"/>
        <files expression="${project.file}"/>
        <!-- A manifest made by another mojo (maven-bundle-plugin's target/osgi/MANIFEST.MF). -->
        <files parameter="archive.manifestFile"/>
      </inputs>
      <outputs>
        <file parameter="outputDirectory" name="{finalName}{-classifier}.jar"/>
      </outputs>
      <ignoredParameters>classesDirectory, forceCreation</ignoredParameters>
      <ignoredWrites>maven-archiver/**</ignoredWrites>
    </mojo>
    <mojo goal="test-jar">
      <inputs>
        <files parameter="testClassesDirectory"/>
        <files expression="${project.file}"/>
        <files parameter="archive.manifestFile"/>
      </inputs>
      <outputs>
        <file parameter="outputDirectory" name="{finalName}{-classifier}.jar"/>
      </outputs>
      <ignoredParameters>testClassesDirectory, forceCreation</ignoredParameters>
      <ignoredWrites>maven-archiver/**</ignoredWrites>
    </mojo>
  </plugin>

  <plugin groupId="org.apache.maven.plugins" artifactId="maven-source-plugin">
    <!-- The forking "jar" goal is skipped (it re-runs a lifecycle); jar-no-fork is the cacheable one. -->
    <mojo goal="jar-no-fork">
      <inputs>
        <files expression="${project.compileSourceRoots}"/>
        <resources expression="${project.resources}"/>
        <files expression="${project.file}"/>
      </inputs>
      <outputs>
        <file parameter="outputDirectory" name="{finalName}{-classifier}.jar"/>
      </outputs>
      <ignoredParameters>forceCreation, defaultManifestFile</ignoredParameters>
      <ignoredWrites>maven-archiver/**</ignoredWrites>
    </mojo>
    <mojo goal="test-jar-no-fork">
      <inputs>
        <files expression="${project.testCompileSourceRoots}"/>
        <resources expression="${project.testResources}"/>
        <files expression="${project.file}"/>
      </inputs>
      <outputs>
        <file parameter="outputDirectory" name="{finalName}{-classifier}.jar"/>
      </outputs>
      <ignoredParameters>forceCreation, defaultManifestFile</ignoredParameters>
      <ignoredWrites>maven-archiver/**</ignoredWrites>
    </mojo>
  </plugin>

  <plugin groupId="org.apache.maven.plugins" artifactId="maven-surefire-plugin">
    <mojo goal="test">
      <inputs>
        <testClasspath/>
        <files parameter="classesDirectory"/>
        <files parameter="testClassesDirectory"/>
        <files parameter="suiteXmlFiles"/>
        <files parameter="includesFile"/>
        <files parameter="excludesFile"/>
        <files parameter="systemPropertiesFile"/>
      </inputs>
      <outputs>
        <directory parameter="reportsDirectory"/>
        <!-- The tests run with hooks of their own (JaCoCo's agent, test code writing files): every file
             written in the build directory during the run is an output. -->
        <observed/>
      </outputs>
      <ignoredParameters>
        classesDirectory, testClassesDirectory,
        consoleOutputReporter, statelessTestsetInfoReporter, statelessTestsetReporter, forkNode,
        printSummary, trimStackTrace, tempDir, debugForkedProcess, parallelMavenExecution,
        enableProcessChecker, forkedProcessExitTimeoutInSeconds, shutdown
      </ignoredParameters>
      <!-- Forked-JVM booter files, normally deleted after the run. -->
      <ignoredWrites>surefire/**</ignoredWrites>
    </mojo>
  </plugin>

  <plugin groupId="org.apache.maven.plugins" artifactId="maven-failsafe-plugin">
    <!-- Integration tests often reach outside the project (servers, containers, databases): if yours
         do, mark this goal cacheable="false" in .mvn/plugin-io/. -->
    <mojo goal="integration-test">
      <inputs>
        <testClasspath/>
        <files parameter="classesDirectory"/>
        <files parameter="defaultClassesDirectory"/>
        <files parameter="testClassesDirectory"/>
        <files parameter="suiteXmlFiles"/>
        <files parameter="includesFile"/>
        <files parameter="excludesFile"/>
        <files parameter="systemPropertiesFile"/>
      </inputs>
      <outputs>
        <directory parameter="reportsDirectory"/>
        <observed/>
      </outputs>
      <ignoredParameters>
        classesDirectory, defaultClassesDirectory, testClassesDirectory,
        consoleOutputReporter, statelessTestsetInfoReporter, statelessTestsetReporter, forkNode,
        printSummary, trimStackTrace, tempDir, debugForkedProcess, parallelMavenExecution,
        enableProcessChecker, forkedProcessExitTimeoutInSeconds, shutdown
      </ignoredParameters>
      <!-- Forked-JVM booter files, normally deleted after the run. -->
      <ignoredWrites>surefire/**</ignoredWrites>
    </mojo>
    <!-- Only reads the summary written by integration-test; fails the build on failures. -->
    <mojo goal="verify">
      <inputs>
        <files parameter="summaryFile"/>
        <files parameter="summaryFiles"/>
      </inputs>
      <ignoredParameters>summaryFile, summaryFiles, reportsDirectory, testClassesDirectory</ignoredParameters>
    </mojo>
  </plugin>

  <plugin groupId="org.jacoco" artifactId="jacoco-maven-plugin">
    <mojo goal="prepare-agent">
      <inputs>
        <!-- prepare-agent prepends to the existing property, so its current value is an input. -->
        <projectProperty nameParameter="propertyName" defaultName="argLine"/>
      </inputs>
    </mojo>
    <!-- Fails the build when the coverage rules (configuration) are not met; writes nothing. -->
    <mojo goal="check">
      <inputs>
        <files parameter="dataFile"/>
        <files expression="${project.build.outputDirectory}"/>
      </inputs>
      <ignoredParameters>dataFile</ignoredParameters>
    </mojo>
    <mojo goal="report">
      <inputs>
        <files parameter="dataFile"/>
        <files expression="${project.build.outputDirectory}"/>
        <files expression="${project.compileSourceRoots}"/>
      </inputs>
      <outputs>
        <directory parameter="outputDirectory"/>
      </outputs>
      <ignoredParameters>dataFile</ignoredParameters>
    </mojo>
  </plugin>

  <!-- Effects outside the project: always run. -->
  <plugin groupId="org.apache.maven.plugins" artifactId="maven-clean-plugin">
    <mojo goal="clean" cacheable="false" reason="deletes outputs; nothing to cache"/>
  </plugin>
  <plugin groupId="org.apache.maven.plugins" artifactId="maven-install-plugin">
    <mojo goal="install" cacheable="false" reason="writes to the local repository"/>
  </plugin>
  <plugin groupId="org.apache.maven.plugins" artifactId="maven-deploy-plugin">
    <mojo goal="deploy" cacheable="false" reason="publishes to a remote repository"/>
  </plugin>
</plugin-io>
