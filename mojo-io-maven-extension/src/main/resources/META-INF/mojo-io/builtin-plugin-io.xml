<?xml version="1.0" encoding="UTF-8"?>
<!--
  Built-in plugin I/O declarations: the lowest-precedence source. A plugin's own
  META-INF/maven/plugin-io.xml overrides these, and a project's .mvn/plugin-io/*.xml overrides both.
  These are written so they could move into the plugins themselves unchanged.
-->
<plugin-io xmlns="urn:mojo-io:plugin-io:1.0">

  <plugin groupId="org.apache.maven.plugins" artifactId="maven-resources-plugin">
    <mojo goal="resources" stamping="carry">
      <inputs>
        <resources parameter="resources"/>
        <files parameter="filters"/>
        <files parameter="buildFilters"/>
      </inputs>
      <outputs>
        <copiedResources resourcesParameter="resources" outputDirectoryParameter="outputDirectory"/>
      </outputs>
      <ignoredParameters>resources</ignoredParameters>
    </mojo>
    <mojo goal="testResources" stamping="carry">
      <inputs>
        <resources parameter="resources"/>
        <files parameter="filters"/>
        <files parameter="buildFilters"/>
      </inputs>
      <outputs>
        <copiedResources resourcesParameter="resources" outputDirectoryParameter="outputDirectory"/>
      </outputs>
      <ignoredParameters>resources</ignoredParameters>
    </mojo>
  </plugin>

  <plugin groupId="org.apache.maven.plugins" artifactId="maven-compiler-plugin">
    <mojo goal="compile" prerequisitePhase="process-resources" stamping="carry">
      <inputs>
        <files parameter="compileSourceRoots"/>
        <!-- compilePath starts with the mojo's own target/classes; hashing it would make the key
             depend on the previous run's outputs. -->
        <classpath parameter="compilePath" excludeParameter="outputDirectory"/>
      </inputs>
      <outputs>
        <directory parameter="outputDirectory" includes="**/*.class"/>
        <directory parameter="generatedSourcesDirectory"/>
      </outputs>
      <ignoredParameters>
        compileSourceRoots, compilePath,
        showCompilationChanges, skipMultiThreadWarning, compilerReuseStrategy, verbose, staleMillis
      </ignoredParameters>
    </mojo>
    <mojo goal="testCompile" prerequisitePhase="process-test-resources" stamping="carry">
      <inputs>
        <files parameter="compileSourceRoots"/>
        <classpath parameter="testPath" excludeParameter="outputDirectory"/>
      </inputs>
      <outputs>
        <directory parameter="outputDirectory" includes="**/*.class"/>
        <directory parameter="generatedTestSourcesDirectory"/>
      </outputs>
      <ignoredParameters>
        compileSourceRoots, testPath,
        showCompilationChanges, skipMultiThreadWarning, compilerReuseStrategy, verbose, staleMillis
      </ignoredParameters>
    </mojo>
  </plugin>

  <plugin groupId="org.apache.maven.plugins" artifactId="maven-jar-plugin">
    <!-- Packages classes plus metadata that embeds the version (pom.properties, the pom, MANIFEST.MF):
         stamp values are rewritten inside the restored jar and in its file name. -->
    <mojo goal="jar" prerequisitePhase="prepare-package" stamping="carry">
      <inputs>
        <files parameter="classesDirectory"/>
        <files expression="${project.file}"/>
      </inputs>
      <outputs>
        <file parameter="outputDirectory" name="{finalName}{-classifier}.jar"/>
      </outputs>
      <ignoredParameters>classesDirectory, forceCreation</ignoredParameters>
    </mojo>
  </plugin>

  <!-- Tests act on what they read (a test may assert the version), so stamps stay in their key. -->
  <plugin groupId="org.apache.maven.plugins" artifactId="maven-surefire-plugin">
    <mojo goal="test" prerequisitePhase="process-test-classes">
      <inputs>
        <testClasspath/>
        <files parameter="classesDirectory"/>
        <files parameter="testClassesDirectory"/>
        <files parameter="suiteXmlFiles"/>
        <files parameter="includesFile"/>
        <files parameter="excludesFile"/>
        <files parameter="systemPropertiesFile"/>
      </inputs>
      <outputs>
        <directory parameter="reportsDirectory"/>
        <!-- JaCoCo's agent writes coverage during the test run. -->
        <javaagentDestFiles parameter="argLine"/>
      </outputs>
      <ignoredParameters>
        classesDirectory, testClassesDirectory,
        consoleOutputReporter, statelessTestsetInfoReporter, statelessTestsetReporter, forkNode,
        printSummary, trimStackTrace, tempDir, debugForkedProcess, parallelMavenExecution,
        enableProcessChecker, forkedProcessExitTimeoutInSeconds, shutdown
      </ignoredParameters>
    </mojo>
  </plugin>

  <plugin groupId="org.jacoco" artifactId="jacoco-maven-plugin">
    <mojo goal="prepare-agent">
      <inputs>
        <!-- prepare-agent prepends to the existing property, so its current value is an input. -->
        <projectProperty nameParameter="propertyName" defaultName="argLine"/>
      </inputs>
    </mojo>
  </plugin>
</plugin-io>
