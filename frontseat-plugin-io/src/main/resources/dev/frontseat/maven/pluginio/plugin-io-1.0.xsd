<?xml version="1.0" encoding="UTF-8"?>
<!--
  plugin-io 1.0: what a Maven mojo reads and writes, declared in terms of its parameters.

  Every attribute named "parameter" refers to a mojo parameter. Its value is evaluated the way Maven
  configures the mojo (configured expression, else default-value), so the declarations hold for any
  configuration of the plugin.

  Readers MUST treat an unknown input/output kind as "cannot cache this mojo".
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="https://frontseat.dev/xsd/plugin-io/1.0"
           targetNamespace="https://frontseat.dev/xsd/plugin-io/1.0"
           elementFormDefault="qualified">

  <xs:element name="plugin-io">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="plugin" type="Plugin" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:complexType name="Plugin">
    <xs:sequence>
      <xs:element name="mojo" type="Mojo" maxOccurs="unbounded"/>
    </xs:sequence>
    <!-- Optional inside the plugin's own jar (META-INF/maven/plugin-io.xml), required elsewhere. -->
    <xs:attribute name="groupId" type="xs:string"/>
    <xs:attribute name="artifactId" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="Mojo">
    <xs:sequence>
      <xs:element name="inputs" type="Inputs" minOccurs="0"/>
      <xs:element name="outputs" type="Outputs" minOccurs="0"/>
      <!-- Comma or whitespace separated parameters that cannot affect outputs. -->
      <xs:element name="ignoredParameters" type="xs:string" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="goal" type="xs:string" use="required"/>
    <xs:attribute name="cacheable" type="xs:boolean" default="true"/>
    <!-- Required when cacheable="false". -->
    <xs:attribute name="reason" type="xs:string"/>
    <!-- Phase that must have run before this goal when it is invoked directly. -->
    <xs:attribute name="prerequisitePhase" type="xs:string"/>
  </xs:complexType>

  <xs:complexType name="Inputs">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <!-- Content of the files / directory trees a parameter names (a path or a list of paths). -->
      <xs:element name="files" type="ParameterRef"/>
      <!-- An ordered classpath; elements hashed by content, not location. -->
      <xs:element name="classpath">
        <xs:complexType>
          <xs:attribute name="parameter" type="xs:string" use="required"/>
          <!-- Skip this entry (typically the mojo's own output directory). -->
          <xs:attribute name="excludeParameter" type="xs:string"/>
        </xs:complexType>
      </xs:element>
      <!-- The project's resolved test classpath, for mojos that compute it internally. -->
      <xs:element name="testClasspath">
        <xs:complexType/>
      </xs:element>
      <!-- A List<Resource> parameter: resource settings plus selected file content; filtering adds
           project coordinates, project properties and user properties. -->
      <xs:element name="resources" type="ParameterRef"/>
      <!-- Current value of a project property the mojo reads and rewrites. -->
      <xs:element name="projectProperty">
        <xs:complexType>
          <xs:attribute name="nameParameter" type="xs:string"/>
          <xs:attribute name="defaultName" type="xs:string" use="required"/>
        </xs:complexType>
      </xs:element>
    </xs:choice>
  </xs:complexType>

  <xs:complexType name="Outputs">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <!-- Files under a directory parameter matching Ant-style includes (default: everything). -->
      <xs:element name="directory">
        <xs:complexType>
          <xs:attribute name="parameter" type="xs:string" use="required"/>
          <xs:attribute name="includes" type="xs:string" default="**"/>
        </xs:complexType>
      </xs:element>
      <!-- The files a resources mojo copies into an output directory. -->
      <xs:element name="copiedResources">
        <xs:complexType>
          <xs:attribute name="resourcesParameter" type="xs:string" use="required"/>
          <xs:attribute name="outputDirectoryParameter" type="xs:string" use="required"/>
        </xs:complexType>
      </xs:element>
      <!-- destfile= targets of -javaagent options in a command-line parameter (coverage data). -->
      <xs:element name="javaagentDestFiles" type="ParameterRef"/>
    </xs:choice>
  </xs:complexType>

  <xs:complexType name="ParameterRef">
    <xs:attribute name="parameter" type="xs:string" use="required"/>
  </xs:complexType>
</xs:schema>
