<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.frontseat.maven</groupId>
    <artifactId>frontseat-maven-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>frontseat-it</artifactId>
  <name>Frontseat Maven :: Integration Tests</name>
  <description>
    Forks real Maven builds of the sample projects under src/it/projects with the extension loaded,
    and asserts on cache hits, restored outputs and restored project state.
  </description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.install.skip>true</maven.install.skip>
    <!-- Fork a different Maven for the ITs, e.g. a Maven 4 install (see mise.toml). -->
    <frontseat.it.maven.home/>
    <frontseat.it.expectMavenVersion/>
  </properties>

  <dependencies>
    <!-- Only here so the reactor builds the extension first; the ITs load its jars directly. -->
    <dependency>
      <groupId>dev.frontseat.maven</groupId>
      <artifactId>frontseat-maven-extension</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- Exposes the extension's runtime jars (extension + cache core) as ${frontseat.ext.classpath}. -->
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>extension-classpath</id>
            <phase>pre-integration-test</phase>
            <goals>
              <goal>build-classpath</goal>
            </goals>
            <configuration>
              <includeGroupIds>dev.frontseat.maven</includeGroupIds>
              <includeScope>test</includeScope>
              <outputProperty>frontseat.ext.classpath</outputProperty>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <systemPropertyVariables>
            <maven.home>${maven.home}</maven.home>
            <frontseat.it.maven.home>${frontseat.it.maven.home}</frontseat.it.maven.home>
            <frontseat.it.expectMavenVersion>${frontseat.it.expectMavenVersion}</frontseat.it.expectMavenVersion>
            <frontseat.ext.classpath>${frontseat.ext.classpath}</frontseat.ext.classpath>
            <frontseat.it.projects>${project.basedir}/src/it/projects</frontseat.it.projects>
            <frontseat.it.work>${project.build.directory}/it</frontseat.it.work>
            <frontseat.it.localRepo>${settings.localRepository}</frontseat.it.localRepo>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
