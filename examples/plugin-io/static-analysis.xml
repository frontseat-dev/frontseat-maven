<?xml version="1.0" encoding="UTF-8"?>
<!--
  Declarations for static-analysis checks: checkstyle:check, spotbugs:check, pmd:check.
  Copy into a project's .mvn/plugin-io/ to cache them. Verified on Apache Commons Numbers
  (docs/real-projects.md): checkstyle 3.6.0, spotbugs-maven-plugin 4.10.4.0, maven-pmd-plugin 3.28.0.

  Not built in, because they only cover the files the plugin configuration points at directly.
  Before relying on them, check for inputs they cannot see, and add a <files> input for each:
  - files a configuration file refers to itself (a checkstyle.xml that loads a suppressions or header
    file through a property, a PMD ruleset that includes another ruleset file);
  - configuration loaded from a URL (its content is not hashed).
  A hit also skips the console output of the check (warnings that do not fail the build).
  Also not covered: checkstyle with skipExec=true (it then reads an earlier result file), and SpotBugs
  plugin lists or user preferences files.

  To see what a declaration really hashes, read target/mojo-io/<plugin>-<goal>-<execution>.key.txt
  after a build: an input that should list files but is empty is a gap.
-->
<plugin-io xmlns="urn:mojo-io:plugin-io:1.0">

  <plugin groupId="org.apache.maven.plugins" artifactId="maven-checkstyle-plugin">
    <mojo goal="check">
      <inputs>
        <!-- sourceDirectories is empty by default: the mojo then reads the project's source roots. -->
        <files parameter="sourceDirectories"/>
        <files parameter="testSourceDirectories"/>
        <files expression="${project.compileSourceRoots}"/>
        <files expression="${project.testCompileSourceRoots}"/>
        <resources parameter="resources"/>
        <resources parameter="testResources"/>
        <files parameter="configLocation"/>
        <files parameter="headerLocation"/>
        <files parameter="suppressionsLocation"/>
        <files parameter="propertiesLocation"/>
      </inputs>
      <outputs>
        <observed/>
      </outputs>
      <ignoredParameters>sourceDirectories, testSourceDirectories, resources, testResources</ignoredParameters>
    </mojo>
  </plugin>

  <plugin groupId="com.github.spotbugs" artifactId="spotbugs-maven-plugin">
    <!-- check forks spotbugs:spotbugs: cached as one unit. -->
    <mojo goal="check">
      <outputs>
        <observed/>
      </outputs>
    </mojo>
    <mojo goal="spotbugs">
      <inputs>
        <testClasspath/>
        <files parameter="classFilesDirectory"/>
        <files parameter="testClassFilesDirectory"/>
        <files parameter="excludeFilterFile"/>
        <files parameter="includeFilterFile"/>
        <files parameter="excludeBugsFile"/>
      </inputs>
      <outputs>
        <observed/>
      </outputs>
      <ignoredParameters>classFilesDirectory, testClassFilesDirectory</ignoredParameters>
    </mojo>
  </plugin>

  <plugin groupId="org.apache.maven.plugins" artifactId="maven-pmd-plugin">
    <!-- check forks pmd:pmd: cached as one unit. -->
    <mojo goal="check">
      <inputs>
        <files parameter="excludeFromFailureFile"/>
      </inputs>
      <outputs>
        <observed/>
      </outputs>
    </mojo>
    <mojo goal="pmd">
      <inputs>
        <testClasspath/>
        <files expression="${project.build.outputDirectory}"/>
        <files parameter="compileSourceRoots"/>
        <files parameter="testSourceRoots"/>
        <files parameter="rulesets"/>
      </inputs>
      <outputs>
        <observed/>
      </outputs>
      <ignoredParameters>compileSourceRoots, testSourceRoots</ignoredParameters>
    </mojo>
  </plugin>
</plugin-io>
