<?xml version="1.0" encoding="UTF-8"?>
<!--
  Declarations for Eclipse Tycho builds (Tycho 4 and 5). Copy into a project's .mvn/plugin-io/.
  Verified on Tycho's RCP demo (docs/real-projects.md).

  Tycho compiles from its own model: source folders and output from build.properties, the classpath
  from the bundles p2 resolved for the MANIFEST.MF. The test classpath input covers those bundles by
  their fully qualified versions (p2 never reuses a version for other content) and bundles of this
  reactor by content.

  A build qualifier is written into every manifest and feature.xml. With Tycho's default (the build
  time) every build is new: use a fixed qualifier (forceContextQualifier) or one from git
  (tycho-buildtimestamp-jgit), or nothing downstream of the qualifier can be reused.

  Not covered: compiler settings from a target platform's execution environment that change without a
  version change; extraClasspathElements given as dependencies (such a mojo runs uncached).
-->
<plugin-io xmlns="urn:mojo-io:plugin-io:1.0">
  <!-- The build extension: what it reads while Maven loads each project, to compute the project's
       dependencies and resolve its target platform. -->
  <plugin groupId="org.eclipse.tycho" artifactId="tycho-maven-plugin">
    <projectLoad>
      META-INF/MANIFEST.MF, META-INF/p2.inf, build.properties, feature.xml, p2.inf, p2iu.xml,
      category.xml, *.product, *.p2.inf, *.target, .polyglot.*
    </projectLoad>
  </plugin>

  <plugin groupId="org.eclipse.tycho" artifactId="tycho-compiler-plugin">
    <mojo goal="compile" stamping="carry">
      <inputs>
        <!-- The source folders build.properties names: Tycho sets them as compile source roots while
             the build runs (validate-classpath), so a task graph exported beforehand would see Maven's
             defaults instead. The project's own files cover them, MANIFEST.MF, build.properties and
             the JDT settings (useProjectSettings). -->
        <projectFiles/>
        <testClasspath ownOutputs="false"/>
      </inputs>
      <outputs>
        <!-- Classes and the resources copied from the source folders (copyResources). -->
        <directory expression="${project.build.outputDirectory}"/>
        <directory parameter="generatedSourcesDirectory"/>
      </outputs>
      <ignoredWrites>maven-status/**, compile-logs/**</ignoredWrites>
    </mojo>
    <mojo goal="testCompile" stamping="carry">
      <inputs>
        <projectFiles/>
        <files expression="${project.build.outputDirectory}"/>
        <testClasspath ownOutputs="false"/>
      </inputs>
      <outputs>
        <directory expression="${project.build.testOutputDirectory}"/>
        <directory parameter="generatedSourcesDirectory"/>
      </outputs>
      <ignoredWrites>maven-status/**, compile-logs/**</ignoredWrites>
    </mojo>
  </plugin>

  <!-- Component descriptions from the OSGi DS annotations of the compiled classes (when enabled in the
       pom or in .settings/org.eclipse.pde.ds.annotations.prefs). The Service-Component header it hands
       to package-plugin is recorded as project state. -->
  <plugin groupId="org.eclipse.tycho" artifactId="tycho-ds-plugin">
    <mojo goal="declarative-services">
      <inputs>
        <!-- It discards what an earlier run left in OSGI-INF before analyzing the classes. -->
        <files expression="${project.build.outputDirectory}" excludes="OSGI-INF/**"/>
        <files expression="${project.basedir}/META-INF/MANIFEST.MF"/>
        <files expression="${project.basedir}/.settings"/>
        <testClasspath ownOutputs="false"/>
      </inputs>
      <outputs>
        <directory expression="${project.build.outputDirectory}/OSGI-INF"/>
      </outputs>
    </mojo>
  </plugin>

  <!-- PDE's automatic manifest, generated with bnd when the project has a pde.bnd file; otherwise it
       does nothing. -->
  <plugin groupId="org.eclipse.tycho" artifactId="tycho-bnd-plugin">
    <mojo goal="process">
      <inputs>
        <files expression="${project.basedir}/pde.bnd"/>
        <files expression="${project.basedir}/META-INF/MANIFEST.MF"/>
        <files expression="${project.basedir}/build.properties"/>
        <files expression="${project.build.outputDirectory}"/>
        <testClasspath ownOutputs="false"/>
      </inputs>
      <outputs>
        <observed/>
      </outputs>
    </mojo>
  </plugin>

  <plugin groupId="org.eclipse.tycho" artifactId="tycho-packaging-plugin">
    <!-- Checks that the pom's version and id match the project's own metadata. -->
    <mojo goal="validate-version">
      <inputs>
        <projectModel/>
        <files expression="${project.basedir}/META-INF/MANIFEST.MF"/>
        <files expression="${project.basedir}/feature.xml"/>
        <files expression="${project.basedir}/p2iu.xml"/>
      </inputs>
    </mojo>
    <mojo goal="validate-id">
      <inputs>
        <projectModel/>
        <files expression="${project.basedir}/META-INF/MANIFEST.MF"/>
        <files expression="${project.basedir}/feature.xml"/>
        <files expression="${project.basedir}/p2iu.xml"/>
      </inputs>
    </mojo>
  </plugin>
</plugin-io>
